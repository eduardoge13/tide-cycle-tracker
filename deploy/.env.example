# Copy to deploy/.env (gitignored) and fill in your own values.

# SSH destination used by deploy.sh (a host alias from ~/.ssh/config works best).
DEPLOY_SSH=my-server
# Directory on the server that holds the compose project.
DEPLOY_DIR=/srv/tide

# Public hostname Traefik routes to the container.
TIDE_HOST=tide.example.com
# Existing Docker network your Traefik container is attached to.
TRAEFIK_NETWORK=traefik
# Traefik certificate resolver name (Let's Encrypt).
CERT_RESOLVER=letsencrypt
